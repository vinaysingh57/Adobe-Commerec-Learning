<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Dedicated Monolog channel writing to var/customer_audit_log/customer_audit.log -->
    <virtualType name="Abbott\CustomerAuditLog\Logger\AuditChannel" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">customer_audit</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Abbott\CustomerAuditLog\Logger\Handler\AuditHandler</item>
                <item name="ziggiz" xsi:type="object">Abbott\ZiggizLogger\Logger\Handler\Ziggiz</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Abbott\CustomerAuditLog\Model\AuditLogger">
        <arguments>
            <argument name="logger" xsi:type="object">Abbott\CustomerAuditLog\Logger\AuditChannel</argument>
        </arguments>
    </type>
</config>
