<?xml version="1.0"?>
<!--
    Layout for: admin/mbopasswordreset/password/reset
    Renders only the password-reset block inside the content area.
    No top-level navigation is intentionally added so the MBO user
    cannot navigate away before resetting their password.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Backend\Block\Template"
                   name="mbopasswordreset_reset_form"
                   template="User_MboPasswordReset::password/reset.phtml"
                   cacheable="false"/>
        </referenceContainer>
    </body>
</page>
